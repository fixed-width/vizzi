{
  "name": "vizzi",
  "displayName": "Vizzi",
  "description": "Share VS Code language providers with the Vizzi visual workspace.",
  "version": "0.3.0",
  "publisher": "vizzi",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "capabilities": { "untrustedWorkspaces": { "supported": false }, "virtualWorkspaces": { "supported": false } },
  "contributes": {
    "commands": [
      { "command": "vizzi.openWorkspace", "title": "Vizzi: Open Workspace" },
      { "command": "vizzi.openWorkspaceInBrowser", "title": "Vizzi: Open Workspace in Browser" },
      { "command": "vizzi.stopWorkspace", "title": "Vizzi: Stop Workspace" },
      { "command": "vizzi.shareLanguageProviders", "title": "Vizzi: Share Language Providers (Advanced)" },
      { "command": "vizzi.stopSharing", "title": "Vizzi: Stop Sharing Language Providers" }
    ],
    "configuration": {
      "title": "Vizzi",
      "properties": {
        "vizzi.executablePath": {
          "type": "string", "default": "", "scope": "machine",
          "description": "Override the bundled Vizzi executable with an absolute path for development."
        }
      }
    }
  },
  "scripts": { "test": "node --test *.test.cjs" }
}
