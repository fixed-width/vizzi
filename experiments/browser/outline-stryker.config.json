{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["crates/vizzi/web/outline.js"],
  "testRunner": "command",
  "commandRunner": { "command": "node experiments/browser/outline.test.mjs" },
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 5000,
  "reporters": ["clear-text", "json"],
  "clearTextReporter": { "reportMutants": false, "logTests": false },
  "jsonReporter": { "fileName": "experiments/browser/results/local/outline-mutation.json" },
  "ignorePatterns": ["target", "docs", "crates/vizzi-core", "crates/vizzi-perf", "crates/vizzi/src", "crates/vizzi/tests", "experiments/qualification", "experiments/performance", "experiments/browser/results"],
  "thresholds": { "break": 100 }
}
