{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["crates/vizzi/web/controller.js"],
  "testRunner": "command",
  "commandRunner": { "command": "node crates/vizzi/web/controller.test.js" },
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 2000,
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "experiments/browser/results/local/controller-mutation.json" },
  "ignorePatterns": ["target", "experiments", "docs", "crates/vizzi-core", "crates/vizzi-perf", "crates/vizzi/src", "crates/vizzi/tests"],
  "thresholds": { "break": 100 }
}
