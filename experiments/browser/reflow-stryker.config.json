{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "crates/vizzi/web/reflow.js"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node crates/vizzi/web/reflow.test.js"
  },
  "coverageAnalysis": "off",
  "concurrency": 1,
  "timeoutMS": 5000,
  "reporters": [
    "clear-text",
    "json"
  ],
  "clearTextReporter": {
    "reportMutants": false,
    "logTests": false
  },
  "jsonReporter": {
    "fileName": "/tmp/vizzi-reflow-mutations.json"
  },
  "thresholds": {
    "break": null
  },
  "ignorePatterns": [
    "**",
    "!package.json",
    "!crates/vizzi/web/reflow.js",
    "!crates/vizzi/web/reflow.test.js"
  ]
}
