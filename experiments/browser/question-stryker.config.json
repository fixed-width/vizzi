{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "experiments/companion/question-state.js"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node experiments/companion/question-state.test.js"
  },
  "coverageAnalysis": "off",
  "concurrency": 1,
  "timeoutMS": 5000,
  "reporters": [
    "clear-text",
    "json"
  ],
  "clearTextReporter": {
    "reportMutants": false,
    "logTests": false
  },
  "jsonReporter": {
    "fileName": "/tmp/vizzi-question-node-mutations.json"
  },
  "thresholds": {
    "break": 100
  },
  "ignorePatterns": [
    "**",
    "!package.json",
    "!experiments/companion/question-state.js",
    "!experiments/companion/question-state.test.js"
  ]
}
